{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proof Registry Index",
  "type": "object",
  "required": ["protocol_version", "generated_at", "entries"],
  "properties": {
    "protocol_version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_hash", "slug", "claim", "verdict",
                     "confidence", "proof_url", "badge_url", "generated_at"],
        "properties": {
          "claim_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "slug": { "type": "string" },
          "claim": { "type": "string" },
          "verdict": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "doi": { "type": ["string", "null"] },
          "proof_url": { "type": "string", "format": "uri" },
          "badge_url": { "type": "string", "format": "uri" },
          "generated_at": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
