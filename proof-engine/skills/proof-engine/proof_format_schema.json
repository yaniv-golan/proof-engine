{
  "_comment": "Single source of truth for proof markdown section requirements. Consumed by tools/lib/proof_loader.py, tools/lib/narrative_validator.py, and verified against site/templates/proof.html by tests.",
  "proof_md": {
    "v1": {
      "required": [
        "Key Findings",
        "Claim Interpretation",
        "Evidence Summary",
        "Proof Logic",
        "Conclusion"
      ],
      "optional": ["Counter-Evidence Search"]
    },
    "v2": {
      "required": [
        "Evidence Summary",
        "Proof Logic",
        "Conclusion"
      ],
      "optional": ["What Could Challenge This Verdict?"]
    }
  },
  "proof_audit_md": {
    "v1": {
      "required": [],
      "optional": [
        "Claim Specification",
        "Citation Verification Details",
        "Computation Traces",
        "Independent Source Agreement",
        "Adversarial Checks",
        "Hardening Checklist",
        "Source Credibility Assessment",
        "Extraction Records"
      ]
    },
    "v2": {
      "required": [],
      "optional": [
        "Claim Specification",
        "Claim Interpretation",
        "Citation Verification Details",
        "Computation Traces",
        "Independent Source Agreement",
        "Adversarial Checks",
        "Quality Checks",
        "Source Credibility Assessment",
        "Source Data"
      ]
    },
    "conditional": [
      {
        "section": "Type S (Search) Facts",
        "when": "evidence contains type=search entries",
        "applies_to": ["v1", "v2"]
      }
    ]
  },
  "proof_narrative_md": {
    "required": [
      "Verdict",
      "What Was Claimed?",
      "What Did We Find?",
      "What Should You Keep In Mind?",
      "How Was This Verified?"
    ]
  },
  "template_fallbacks": {
    "_comment": "Heading pairs where the template tries v2 name first, then v1 name. Used by tests to verify template alignment.",
    "Claim Interpretation": {
      "v2_source": "audit",
      "v1_source": "proof_md"
    },
    "Quality Checks": {
      "v1_alias": "Hardening Checklist"
    },
    "Source Data": {
      "v1_alias": "Extraction Records"
    }
  }
}
